{
  "name": "ai-spy",
  "version": "0.1.0",
  "description": "TypeScript sources for ai-spy",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,mts,cts,js,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,mts,cts,js,mjs,cjs}\"",
    "check": "npm run format:check && npm run typecheck && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
